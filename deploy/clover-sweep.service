[Unit]
Description=Yipyy — Clover reconciliation sweep
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

# ── A NON-ZERO EXIT HAS TO REACH SOMEBODY ─────────────────────────────────
#
# clover-sweep.sh already distinguishes three outcomes: success, a failed call
# (exit 1), and a 200 whose body carries a per-facility `problems` array
# (exit 2, "completed WITH PROBLEMS"). Until 2026-08-26 all three looked
# identical from outside, because nothing consumed the exit code — so a sweep
# that had not actually reconciled anything for a week was indistinguishable
# from one that ran a minute ago.
#
# systemd runs this unit on any non-zero exit. `%n` passes the failing unit's
# name so one handler can serve several timers.
OnFailure=yipyy-alert@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/clover-sweep

# systemd will not start a second instance of a service that is still running,
# so a sweep that overran its 15-minute window queues rather than overlapping
# two reconciliations against the same merchant. --max-time 840 in the script
# means that queue should never form in the first place.
TimeoutStartSec=900

# It is background reconciliation. It must never compete with a customer
# checking out or a card reader waiting on a response.
Nice=5
IOSchedulingClass=idle

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
