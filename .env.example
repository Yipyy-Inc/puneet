# Copy to .env.local and fill in. .env.local is gitignored; this template is not.
# NEVER put real values here — this file is committed, and the repo is public.

# ── Supabase ────────────────────────────────────────────────────────────────
# Dashboard > Project Settings > API. Project region is ca-central-1 (Montreal),
# paired with Vercel functions in iad1 (see vercel.json).
#
# Both of these are PUBLIC by design: they ship in the browser bundle. They
# identify the project; they authorise nothing on their own. Every permission
# decision is made by RLS against the caller's JWT.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>

# The SERVICE ROLE key bypasses RLS completely, so a single leak exposes every
# facility's data. It is listed here — rather than left undocumented — because
# ONE route genuinely needs it and a key people add ad-hoc without knowing what
# it does is worse than one written down with the warning attached.
#
# Used by exactly one thing: creating the auth account for a new hire
# (src/app/api/staff/[id]/invite/route.ts, via src/lib/supabase/admin.ts, which
# is `server-only` so importing it into client code fails the build). Creating a
# user is GoTrue's admin API; RLS cannot do it. Every other statement in that
# route goes through the caller's own client so RLS still decides.
#
# NEVER prefix it NEXT_PUBLIC_ — that publishes it to every visitor. Unset, the
# invite route returns `sent:false, reason:"not_configured"` and sends nothing,
# which is the honest answer rather than a half-created hire.
SUPABASE_SERVICE_ROLE_KEY=

# ── Clerk ───────────────────────────────────────────────────────────────────
# Installed and mounted, but NOT yet the identity provider — Supabase Auth
# still owns sign-in (src/lib/auth/actions.ts + the portal login pages). Two
# identity sources cannot both own a session, so before Clerk gates anything,
# decide how a Clerk identity reaches Postgres RLS (normally a Clerk JWT
# template registered with Supabase as a third-party auth provider).
#
# Unset behaves differently per environment, and the difference bites in CI:
# Clerk's keyless fallback is `isDevelopmentEnvironment() && !isAutomatedEnvironment()`,
# so LOCAL DEV silently auto-provisions a throwaway instance into /.clerk/ and
# boots fine, while CI and production get no such rescue and the proxy throws on
# the missing key at request time. `bun run build` passes either way — the
# middleware never executes during a build — so a green build is NOT evidence
# these are set. Set them before deploying.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_<...>
CLERK_SECRET_KEY=sk_test_<...>

# Signing secret for the user-sync webhook (Clerk Dashboard > Webhooks, per
# endpoint). Read automatically by verifyWebhook() in
# src/app/api/webhooks/clerk/route.ts — unset, every delivery is rejected 400
# and no new user ever gets a profiles row, which reads as "sign-in works but
# every page is empty".
#
# That route ALSO needs SUPABASE_SERVICE_ROLE_KEY above: a webhook carries no
# session, so an RLS-bound client would be `anon` and every write refused.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_<...>

# ── AI ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=

# ── Telephony (Twilio) ──────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Payments (Clover) ───────────────────────────────────────────────────────
# These identify YIPYY as a Clover app, not any facility. Each facility
# authorises that app against their OWN Clover merchant account via OAuth v2,
# and their tokens are stored per-facility in Supabase Vault
# (private.payment_credentials) — never here, and never in the browser.
#
# There is a client-side store, src/lib/clover-config-store.ts, that takes an
# App Secret from a form and writes it to window.localStorage. Nothing
# server-side reads it, and nothing should: a payment app secret in every
# admin's browser is the credential that lets someone charge cards.
#
# From your Clover developer dashboard. The sandbox and production apps have
# DIFFERENT ids and secrets, and pointing a sandbox app at api.clover.com fails
# with an error that looks like a bad secret.
#
# ── BOTH ESTATES RUN AT ONCE ────────────────────────────────────────────────
#
# A connection is served by the estate it was MADE against, which is stored on
# the row. So sandbox merchants keep working after you start connecting real
# ones, and there is always somewhere to test without touching real cards.
#
# Set the estate-scoped variables below for that. The unscoped CLOVER_APP_ID /
# CLOVER_APP_SECRET / CLOVER_REMOTE_APPLICATION_ID are still honoured, but ONLY
# for the estate CLOVER_ENVIRONMENT names — so production can never silently
# inherit sandbox credentials because somebody set one variable and not the
# other. A missing production secret means "not configured", which refuses.
CLOVER_APP_ID=
CLOVER_APP_SECRET=

# The estate-scoped form. Add these when you have a production app; keep the
# sandbox ones set at the same time.
CLOVER_SANDBOX_APP_ID=
CLOVER_SANDBOX_APP_SECRET=
CLOVER_SANDBOX_REMOTE_APPLICATION_ID=
CLOVER_PRODUCTION_APP_ID=
CLOVER_PRODUCTION_APP_SECRET=
CLOVER_PRODUCTION_REMOTE_APPLICATION_ID=

# The Remote Application ID — "{developerId}.{appId}", NOT the App ID. Card
# PRESENT payments are gated on it: every /connect/v1/* call answers 401
# "no Remote Application ID has been configured" until it exists.
#
# Generated in App Settings > App Type: pick the devices, tick REST Clients >
# Web, and answer YES to "is this an integration with an existing point of
# sale?". Saving reveals it. Sandbox and production apps each have their own.
CLOVER_REMOTE_APPLICATION_ID=

# Where a facility connecting TODAY is sent — not "the environment this
# deployment is in", which no longer exists as a concept. Existing connections
# keep using the estate they were made against.
#
# Each estate is a HOST PAIR, and mixing them (authorising on one, exchanging
# the code on the other) is the most common Clover integration failure, so it is
# one variable rather than two:
#   sandbox     sandbox.dev.clover.com   + apisandbox.dev.clover.com
#   production  www.clover.com           + api.clover.com
CLOVER_ENVIRONMENT=sandbox

# The X-Clover-Auth value from Your Apps > [app] > App Settings > Webhooks.
# Clover does NOT sign deliveries — this is a static shared secret repeated on
# every message — so /api/webhooks/clover rejects anything that does not carry
# it, and never acts on what a delivery says: it re-reads the named object from
# Clover's API before believing it.
#
# SET THIS LAST. The verification handshake POSTs {"verificationCode":"…"} with
# no auth header (Clover only starts sending one once the URL is verified), so
# that branch is open while this is unset and closes the moment it is set. The
# code is also written to payment_webhook_events.outcome, so you can read it out
# of the database rather than trawling deployment logs.
CLOVER_WEBHOOK_SIGNING_SECRET=

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_REALTIME_URL=

# ── Ops (optional) ──────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
MONITORING_PROVIDER=
STATUS_SMS_FROM=

# ── Testing (optional) ──────────────────────────────────────────────────────
# Password for the seeded @yipyy.dev development accounts, read by the e2e
# suite (tests/e2e/_auth.ts). Set this after rotating them with
# supabase/seed/rotate-dev-passwords.sql; unset, the suite falls back to the
# documented seed default.
E2E_PASSWORD=

# The card-payment spec (tests/e2e/clover-pay.spec.ts) needs a fixture no
# provisioning script can invent: an UNPAID booking at a facility with a live
# Clover connection, and the signed-in customer that booking belongs to. Unset,
# that spec skips itself rather than failing with a puzzle — a Clover-connected
# merchant is a thing you set up by hand, once.
#
# It puts a REAL card through Clover's sandbox using their documented decline
# number, so it takes no money and leaves no ledger row. Do not point it at a
# production connection.
CLOVER_E2E_BOOKING_REF=
CLOVER_E2E_CUSTOMER_EMAIL=

# The refund spec (tests/e2e/clover-refund.spec.ts) needs more, and SPENDS what
# it is given: an UNREFUNDED Clover payment on a booking, plus a staff member
# who holds `process_refund` at that facility. It gives real money back and
# leaves the booking fully refunded, so it cannot run twice against the same
# charge — hence its own booking ref, separate from the one above.
CLOVER_E2E_REFUND_BOOKING_REF=
CLOVER_E2E_STAFF_EMAIL=

# The apex this deployment answers on. Facility subdomains are <slug>.<this>.
NEXT_PUBLIC_APP_DOMAIN=
