# Copy to .env.local and fill in. .env.local is gitignored; this template is not.
# NEVER put real values here — this file is committed, and the repo is public.

# ── Supabase ────────────────────────────────────────────────────────────────
# Dashboard > Project Settings > API. Project region is ca-central-1 (Montreal),
# paired with Vercel functions in iad1 (see vercel.json).
#
# Both of these are PUBLIC by design: they ship in the browser bundle. They
# identify the project; they authorise nothing on their own. Every permission
# decision is made by RLS against the caller's JWT.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>

# The SERVICE ROLE key bypasses RLS completely, so a single leak exposes every
# facility's data. It is listed here — rather than left undocumented — because
# ONE route genuinely needs it and a key people add ad-hoc without knowing what
# it does is worse than one written down with the warning attached.
#
# Used by exactly one thing: creating the auth account for a new hire
# (src/app/api/staff/[id]/invite/route.ts, via src/lib/supabase/admin.ts, which
# is `server-only` so importing it into client code fails the build). Creating a
# user is GoTrue's admin API; RLS cannot do it. Every other statement in that
# route goes through the caller's own client so RLS still decides.
#
# NEVER prefix it NEXT_PUBLIC_ — that publishes it to every visitor. Unset, the
# invite route returns `sent:false, reason:"not_configured"` and sends nothing,
# which is the honest answer rather than a half-created hire.
SUPABASE_SERVICE_ROLE_KEY=

# ── Clerk ───────────────────────────────────────────────────────────────────
# Installed and mounted, but NOT yet the identity provider — Supabase Auth
# still owns sign-in (src/lib/auth/actions.ts + the portal login pages). Two
# identity sources cannot both own a session, so before Clerk gates anything,
# decide how a Clerk identity reaches Postgres RLS (normally a Clerk JWT
# template registered with Supabase as a third-party auth provider).
#
# Unset behaves differently per environment, and the difference bites in CI:
# Clerk's keyless fallback is `isDevelopmentEnvironment() && !isAutomatedEnvironment()`,
# so LOCAL DEV silently auto-provisions a throwaway instance into /.clerk/ and
# boots fine, while CI and production get no such rescue and the proxy throws on
# the missing key at request time. `bun run build` passes either way — the
# middleware never executes during a build — so a green build is NOT evidence
# these are set. Set them before deploying.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_<...>
CLERK_SECRET_KEY=sk_test_<...>

# Signing secret for the user-sync webhook (Clerk Dashboard > Webhooks, per
# endpoint). Read automatically by verifyWebhook() in
# src/app/api/webhooks/clerk/route.ts — unset, every delivery is rejected 400
# and no new user ever gets a profiles row, which reads as "sign-in works but
# every page is empty".
#
# That route ALSO needs SUPABASE_SERVICE_ROLE_KEY above: a webhook carries no
# session, so an RLS-bound client would be `anon` and every write refused.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_<...>

# ── AI ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=

# ── Telephony (Twilio) ──────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_REALTIME_URL=

# ── Ops (optional) ──────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
MONITORING_PROVIDER=
STATUS_SMS_FROM=

# ── Testing (optional) ──────────────────────────────────────────────────────
# Password for the seeded @yipyy.dev development accounts, read by the e2e
# suite (tests/e2e/_auth.ts). Set this after rotating them with
# supabase/seed/rotate-dev-passwords.sql; unset, the suite falls back to the
# documented seed default.
E2E_PASSWORD=
