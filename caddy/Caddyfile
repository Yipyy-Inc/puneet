# ============================================================================
# Yipyy — TLS termination and reverse proxy.
#
# Replaces what Vercel's edge did, and replaces `src/lib/vercel/domains.ts`
# entirely: a facility subdomain no longer needs an API call to acquire a
# certificate, because Caddy issues one on the first request to it.
# ============================================================================

{
	# ── NO `email` DIRECTIVE, DELIBERATELY ────────────────────────────────
	#
	# Caddy registers an ACME account without a contact address and renews on
	# its own; the address only buys expiry warnings for a renewal that is
	# already automatic.
	#
	# It is NOT written as `email {$ACME_EMAIL}` with an empty default, because
	# an unset variable expands to nothing and `email` with no argument is a
	# PARSE error — which takes the whole proxy down rather than degrading. If
	# you want the notices, add a real address here as a literal.

	servers {
		timeouts {
			read_header 15s
			read_body 30s
			idle 620s
			# ── `write` IS DELIBERATELY NOT SET ─────────────────────────────
			# It caps the entire response. `src/lib/clover/terminal.ts` waits up
			# to 150 seconds for a human to tap a card on a Clover Flex, and
			# calls that "not tuning, a correctness requirement". A write
			# timeout below it severs the connection mid-payment: the customer
			# is charged and Yipyy records nothing. The default is unlimited.
			# Leave it that way.
		}
	}

	# ── ON-DEMAND TLS ──────────────────────────────────────────────────────
	#
	# Caddy asks this endpoint before issuing for a hostname it has not seen:
	# GET ...?domain=<host>, and 2xx authorises it.
	#
	# MANDATORY, not a refinement. DNS keeps a wildcard record, so every
	# conceivable *.yipyy.com name resolves here, and without this gate anyone
	# opening TLS connections with random SNIs makes us request certificates for
	# them. Let's Encrypt allows 50 per registered domain per week — exhaust it
	# and a REAL new facility cannot get a certificate for seven days.
	#
	# Reached at the container alias, so it never passes through a site block.
	on_demand_tls {
		ask http://app:3000/api/internal/tls-ask
	}
}

# ── WHICH COLOUR IS LIVE LIVES IN ITS OWN FILE ────────────────────────────
#
# `upstream.caddy` defines (upstream) as a single `reverse_proxy app_blue:3000`
# or `app_green:3000`, and it is the ONE line a deploy rewrites. Keeping it
# separate is what makes the swap a `caddy reload` rather than a container
# restart: graceful, in-flight requests finish on the old configuration, and
# the certificate store is never touched. A card payment mid-tap survives a
# deploy because of this file.
#
# The whole DIRECTORY is mounted, not these two files individually. Docker
# bind-mounts a single file by INODE, so anything that REPLACES rather than
# rewrites it — scp, `sed -i`, most editors' save — leaves the container reading
# the old content while the new content sits on disk. That cost an hour on
# 2026-08-25, with Caddy reporting a parse error on a line already deleted.
import /etc/caddy/upstream.caddy

# Shared behaviour for every site. The upstream TARGET — and every setting that
# governs how we talk to it — is in the imported snippet above, so the apex and
# the facility subdomains cannot drift apart, and a deploy changes only WHICH
# container is answering.
(yipyy_upstream) {
	encode zstd gzip

	# The TLS gate is Caddy→app over the container network. Answering it
	# publicly would let anyone enumerate which facility slugs exist.
	handle /api/internal/* {
		abort
	}

	handle {
		import upstream
	}
}

# ── The primary hosts ──────────────────────────────────────────────────────
#
# Named explicitly so their certificates are obtained AT STARTUP and renewed
# regardless of app health. The apex carries the Clover webhook, the platform
# admin and customer sign-in; none of it should wait on an ACME round trip.
#
# ── AND THAT IS EXACTLY WHY IT IS A VARIABLE ─────────────────────────────
#
# Caddy tries to obtain a certificate for a NAMED site the moment it starts. If
# `yipyy.com` is named here while yipyy.com's DNS still points at Vercel, the
# HTTP-01 challenge is answered by Vercel, validation fails, and Caddy retries —
# against Let's Encrypt's failed-validation limit of 5 per hostname per hour.
# Repeat that through a parallel run and the ACME account is rate-limited before
# the cutover it was supposed to make safe.
#
# So during the parallel run PRIMARY_HOSTS is `staging.yipyy.com`, whose DNS
# does point here, and it becomes `yipyy.com, www.yipyy.com` at the flip.
{$PRIMARY_HOSTS:yipyy.com, www.yipyy.com} {
	import yipyy_upstream
}

# ── EXTRA SITES, IF THIS BOX HAS ANY ───────────────────────────────────────
#
# A glob that matches nothing is not an error in Caddy, so a box with no extra
# sites needs neither this directory nor a placeholder in it. One box has one:
# `sites/staging.caddy`, where the redesign is reviewed before production sees
# it (ADR 0007).
#
# It must be imported BEFORE the catch-all below to be legible, though Caddy
# does not actually care: it matches the most specific site address rather than
# the first, so a named `staging.yipyy.com` beats `https://` wherever it sits.
# Written here anyway, because the next person reading top to bottom should not
# have to know that rule to believe the file.
#
# Anything landing here is a WHOLE site block with its own address, its own
# upstream and its own gate. It is deliberately not the (upstream) snippet: that
# one is the blue/green pair a deploy rewrites, and a second site pointing at it
# would be production wearing a different hostname.
import /etc/caddy/sites/*.caddy

# ── Every facility subdomain ───────────────────────────────────────────────
# A bare `https://` is a catch-all: it matches any SNI the block above does not
# claim. It cannot be written `*.yipyy.com`, because a wildcard SITE address
# makes Caddy try to obtain a wildcard CERTIFICATE, which needs DNS-01, which
# needs the nameservers — the whole reason this is on-demand instead.
https:// {
	tls {
		on_demand
	}

	# Defence in depth ONLY, and it is important to know why: by the time any
	# matcher runs, the handshake is complete and the certificate has ALREADY
	# been issued. This stops the app from seeing a foreign request; it does not
	# stop issuance. `/api/internal/tls-ask` is what stops issuance.
	@foreign not host *.yipyy.com yipyy.com
	abort @foreign

	import yipyy_upstream
}

# ── Plain HTTP ─────────────────────────────────────────────────────────────
# Named sites get an automatic redirect; the catch-all above does not, so it is
# spelled out. Caddy binds its ACME HTTP-01 handler ahead of these routes, so
# certificate validation still completes.
http:// {
	redir https://{host}{uri} 308
}
